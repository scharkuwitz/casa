# Build context for the Docker image. Keep secrets and runtime data out: the standalone build
# copies a project-root `.env` into `.next/standalone`, which would bake it into the image.
.env
.env.*
!.env.example
*.db
*.db-journal
*.db-wal
*.db-shm
/data/
/uploads/

# Rebuilt inside the image
/node_modules/
/.next/
/src/generated/
next-env.d.ts
*.tsbuildinfo

# Not needed to build
.git
.github
.claude
/coverage/
/test-results/
/playwright-report/
Dockerfile
.dockerignore
compose*.yml
deploy/
